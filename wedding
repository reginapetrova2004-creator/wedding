<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>Свадьба Айсулу и Ян</title>
  <!-- Шрифты -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background-color: #faf8f6;
      font-family: 'Montserrat', sans-serif;
      color: #3e3a36;
      line-height: 1.5;
      padding: 0 0 80px;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px 16px;
    }
    .section {
      background: white;
      border-radius: 28px;
      padding: 36px 24px;
      margin-bottom: 24px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.03);
      border: 1px solid #ede7e2;
      text-align: center;
    }
    h1, h2, h3 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      color: #9b7b6b;
    }
    h2 {
      font-size: 2.2rem;
      margin-bottom: 24px;
      letter-spacing: 1px;
    }
    h3 {
      font-size: 1.8rem;
      margin-bottom: 16px;
    }
    .subtitle {
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #b7a089;
      margin-bottom: 12px;
    }

    /* Стили для фотографий */
    .photo-place {
      margin: 24px 0 16px;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }
    .photo-place img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }
    /* Двойное фото (для истории) */
    .photo-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 24px 0 16px;
    }
    .photo-row .photo-place {
      margin: 0;
    }

    .hero {
      padding: 48px 24px;
    }
    .hero .subtitle {
      margin-bottom: 8px;
    }
    .names {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(3rem, 12vw, 4.5rem);
      font-weight: 600;
      color: #9b7b6b;
      line-height: 1.1;
    }
    .and {
      font-size: 2rem;
      margin: 4px 0;
    }
    .date-time {
      font-size: 1.2rem;
      color: #6b5b4f;
      margin-top: 20px;
      letter-spacing: 2px;
    }
    .divider {
      width: 60px;
      height: 1px;
      background: #d4c3b5;
      margin: 24px auto;
    }
    .story-text {
      text-align: left;
      font-size: 1rem;
      color: #4a423c;
      margin-bottom: 20px;
    }
    .place-card {
      background: #f9f6f3;
      border-radius: 20px;
      padding: 20px;
      margin: 20px 0;
    }
    .place-name {
      font-size: 1.8rem;
      font-family: 'Cormorant Garamond', serif;
      color: #9b7b6b;
    }
    .address {
      color: #6b5b4f;
      margin: 10px 0;
    }
    .timeline {
      text-align: left;
      margin: 20px 0;
    }
    .timeline-item {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px dashed #ddd2c9;
    }
    .timeline-time {
      font-weight: 600;
      color: #9b7b6b;
      min-width: 70px;
    }
    .dresscode {
      background: #efe5de;
      border-radius: 20px;
      padding: 24px;
      margin: 20px 0;
    }
    .countdown {
      display: flex;
      justify-content: space-around;
      margin: 30px 0;
    }
    .countdown-item {
      text-align: center;
    }
    .countdown-number {
      font-size: 2.2rem;
      font-weight: 600;
      font-family: 'Cormorant Garamond', serif;
      color: #9b7b6b;
      line-height: 1;
    }
    .countdown-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #8c7b6e;
    }
    .calendar-wrapper {
      margin: 30px 0 10px;
    }
    .calendar-month {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      color: #9b7b6b;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 8px;
      margin-bottom: 20px;
    }
    .calendar-day-header {
      font-weight: 500;
      color: #b7a089;
      text-transform: uppercase;
      font-size: 0.8rem;
      padding-bottom: 8px;
    }
    .calendar-day {
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      color: #5e5248;
      border-radius: 50%;
      transition: all 0.2s;
    }
    .calendar-day.highlight {
      background: #9b7b6b;
      color: white;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(155, 123, 107, 0.3);
    }
    .calendar-footer-date {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      color: #9b7b6b;
      margin-top: 16px;
      letter-spacing: 4px;
    }
    .calendar-note {
      color: #8c7b6e;
      font-style: italic;
      margin: 8px 0;
    }
    .btn {
      display: inline-block;
      background: #9b7b6b;
      color: white;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 2px;
      padding: 16px 32px;
      border-radius: 40px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background 0.3s;
      margin: 16px 0 8px;
      border: 1px solid #9b7b6b;
      text-align: center;
    }
    .btn-outline {
      background: transparent;
      color: #9b7b6b;
      border: 1px solid #9b7b6b;
    }
    .btn:hover {
      background: #7d6052;
      border-color: #7d6052;
      color: white;
    }
    .contacts {
      font-size: 1.1rem;
      margin: 16px 0;
    }
    @media (max-width: 480px) {
      .container { padding: 12px 10px; }
      .section { padding: 28px 16px; }
    }
    .footer-note {
      text-align: center;
      margin-top: 20px;
      color: #aa9b91;
      font-size: 0.8rem;
    }
    .fixed-rsvp {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      width: auto;
      min-width: 250px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
      margin: 0;
      background: rgba(155, 123, 107, 0.95);
      color: white;
      border: 1px solid #9b7b6b;
      backdrop-filter: blur(4px);
    }
    .fixed-rsvp:hover {
      background: #7d6052;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Hero Section -->
    <div class="section hero">
      <div class="subtitle">THE WEDDING DAY</div>
      <div class="names">АЙСУЛУ</div>
      <div class="and">&</div>
      <div class="names">ЯН</div>
      <div class="date-time">15.08.2026 | 16:00</div>
      <div class="divider"></div>
      
      <!-- Фото пары (можно заменить на своё) -->
      <div class="photo-place">
        <img src="https://drive.google.com/thumbnail?/d/1I2ZF5UH1EjkCDiv5LWf2Th8BH_ntDvTU/view?usp=sharing" alt="Айсулу и Ян">
      </div>
      
      <p style="margin-top:20px; font-style:italic;">ОФИЦИАЛЬНО СТАНЕМ СЕМЬЁЙ</p>
      <p style="margin:10px 0 20px; color:#5e5248;">Если вы сейчас читаете этот текст, значит совсем скоро вы увидите одного из нас в свадебном платье и думаем, что вы догадываетесь, кого именно...</p>
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSd356-Uz9O1RYmIvWE_F79llHR8HUZN-qq3FAfT9QnvF50ooA/viewform?usp=dialog" target="_blank" class="btn">Подтвердить присутствие</a>
    </div>

    <!-- История -->
    <div class="section">
      <h2>НАША ИСТОРИЯ</h2>
      
      <!-- Два фото (например, из прошлого) -->
      <div class="photo-row">
        <div class="photo-place">
          <img src="https://placehold.co/300x300/f9f6f3/9b7b6b?text=Момент+1" alt="Момент 1">
        </div>
        <div class="photo-place">
          <img src="https://placehold.co/300x300/f9f6f3/9b7b6b?text=Момент+2" alt="Момент 2">
        </div>
      </div>
      
      <div class="story-text">
        <p>Все началось в институте. Мы были просто знакомыми, проходили мимо друг друга каждый день, но не общались.</p>
        <p>Однажды, на одной из вечеринок института, мы случайно оказались в одной компании. Начали разговаривать, и сразу почувствовали непринужденность и понимание друг друга. Наше общение было легким и приятным, словно мы знали друг друга всю жизнь.</p>
        <p>С тех пор мы стали проводить всё больше времени вместе, и вот теперь готовимся к самому важному дню.</p>
      </div>
    </div>

    <!-- Место проведения -->
    <div class="section">
      <h2>НАША СВАДЬБА ПРОЙДЁТ В</h2>
      
      <!-- Фото площадки -->
      <div class="photo-place">
        <img src="https://placehold.co/600x350/f9f6f3/9b7b6b?text=Hide+Restaurant" alt="Hide Restaurant">
      </div>
      
      <div class="place-card">
        <div class="place-name">«HIDE»</div>
        <div class="address">
          Адрес: Московская область,<br>
          городской округ Мытищи,<br>
          Хлебниковский лесопарк
        </div>
      </div>
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSd356-Uz9O1RYmIvWE_F79llHR8HUZN-qq3FAfT9QnvF50ooA/viewform?usp=dialog" target="_blank" class="btn">Подтвердить присутствие</a>
    </div>

    <!-- Тайминг и дресс-код -->
    <div class="section">
      <h2>ТАЙМИНГ</h2>
      <div class="timeline">
        <div class="timeline-item"><span class="timeline-time">16:00</span> <span>Сбор гостей</span></div>
        <div class="timeline-item"><span class="timeline-time">16:30</span> <span>Церемония регистрации</span></div>
        <div class="timeline-item"><span class="timeline-time">17:00</span> <span>Начало банкета</span></div>
        <div class="timeline-item"><span class="timeline-time">23:00</span> <span>Завершение вечера</span></div>
      </div>
      
      <!-- Ещё одно фото (например, декор или кольца) -->
      <div class="photo-place">
        <img src="https://placehold.co/600x300/f9f6f3/9b7b6b?text=Детали" alt="Детали свадьбы">
      </div>
      
      <h3 style="margin-top:32px;">DRESS CODE</h3>
      <div class="dresscode">
        <p>Мы очень ждём и готовимся к нашему незабываемому дню! Поддержите нас Вашими улыбками и объятиями, а также красивыми нарядами в палитре мероприятия.</p>
        <p style="margin-top:16px;"><strong>Для девушек:</strong> вечерние платья в пастельных тонах.<br>
        <strong>Для мужчин:</strong> костюмы светлых оттенков.</p>
      </div>
    </div>

    <!-- Обратный отсчёт -->
    <div class="section">
      <h2>ДО НАШЕЙ СВАДЬБЫ ОСТАЛОСЬ</h2>
      <div class="countdown" id="countdown">
        <div class="countdown-item"><span class="countdown-number" id="days">00</span><div class="countdown-label">Дней</div></div>
        <div class="countdown-item"><span class="countdown-number" id="hours">00</span><div class="countdown-label">Часов</div></div>
        <div class="countdown-item"><span class="countdown-number" id="minutes">00</span><div class="countdown-label">Минут</div></div>
        <div class="countdown-item"><span class="countdown-number" id="seconds">00</span><div class="countdown-label">Секунд</div></div>
      </div>
      <p style="margin-top:24px; font-style:italic;">Будем очень признательны, если Вы воздержитесь от криков «Горько». Ведь поцелуй – это знак выражения чувств, и он не может быть по заказу.</p>
    </div>

    <!-- Календарь -->
    <div class="section">
      <h2>МЫ ЖДЁМ</h2>
      <div class="calendar-wrapper">
        <div class="calendar-month">Август 2026</div>
        <div class="calendar-grid" id="calendar-grid"></div>
        <div class="calendar-footer-date">15 08 26</div>
        <div class="calendar-note">Сохраните дату</div>
      </div>
    </div>

    <!-- Контакты -->
    <div class="section">
      <h2>КОНТАКТЫ</h2>
      <p>По всем вопросам, связанным с мероприятием, вы можете связаться с нами:</p>
      <div class="contacts">
        📞 +7 (916) 777-88-77<br>
        📞 +7 (926) 888-77-88
      </div>
      <a href="tel:+79167778877" class="btn-outline btn" style="margin-top:8px;">Связаться</a>
    </div>

    <!-- Подтверждение присутствия -->
    <div class="section" id="rsvp">
      <h2>БУДЕМ РАДЫ ВИДЕТЬ</h2>
      <p>Пожалуйста, подтвердите ваше присутствие на нашей свадьбе до:</p>
      <p style="font-size:1.5rem; margin:8px 0; font-family:'Cormorant Garamond';">01 08 26</p>
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSd356-Uz9O1RYmIvWE_F79llHR8HUZN-qq3FAfT9QnvF50ooA/viewform?usp=dialog" target="_blank" class="btn">Подтвердить присутствие</a>
      <p style="margin-top:20px; font-family:'Cormorant Garamond'; font-size:1.8rem;">ДО СКОРОЙ ВСТРЕЧИ!</p>
    </div>
    
    <div class="footer-note">С любовью, Айсулу и Ян</div>
  </div>

  <!-- Фиксированная кнопка -->
  <a href="https://docs.google.com/forms/d/e/1FAIpQLSd356-Uz9O1RYmIvWE_F79llHR8HUZN-qq3FAfT9QnvF50ooA/viewform?usp=dialog" target="_blank" class="btn fixed-rsvp">Подтвердить присутствие</a>

  <script>
    // Обратный отсчёт
    const weddingDate = new Date("August 15, 2026 16:00:00").getTime();
    const countdown = setInterval(function() {
      const now = new Date().getTime();
      const distance = weddingDate - now;
      if (distance < 0) {
        clearInterval(countdown);
        document.getElementById("countdown").innerHTML = "<p style='font-size:1.5rem;'>Свадьба уже состоялась!</p>";
        return;
      }
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      document.getElementById("days").innerText = days.toString().padStart(2, '0');
      document.getElementById("hours").innerText = hours.toString().padStart(2, '0');
      document.getElementById("minutes").innerText = minutes.toString().padStart(2, '0');
      document.getElementById("seconds").innerText = seconds.toString().padStart(2, '0');
    }, 1000);

    // Календарь
    (function generateCalendar() {
      const year = 2026;
      const month = 7; // Август
      const firstDay = new Date(year, month, 1).getDay();
      let startOffset = firstDay === 0 ? 6 : firstDay - 1;
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const daysOfWeek = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
      let calendarHTML = '';
      daysOfWeek.forEach(day => { calendarHTML += `<div class="calendar-day-header">${day}</div>`; });
      for (let i = 0; i < startOffset; i++) { calendarHTML += `<div class="calendar-day empty"></div>`; }
      for (let d = 1; d <= daysInMonth; d++) {
        const isWeddingDay = (d === 15);
        calendarHTML += `<div class="calendar-day ${isWeddingDay ? 'highlight' : ''}">${d}</div>`;
      }
      document.getElementById('calendar-grid').innerHTML = calendarHTML;
    })();
  </script>
</body>
</html>
